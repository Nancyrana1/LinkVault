{
  "manifest_version": 3,
  "name": "LinkVault",
  "version": "1.0.0",
  "description": "Save, copy, and autofill your profile links.",
  "permissions": ["storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "LinkVault", "default_popup": "popup.html"},
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }]
}